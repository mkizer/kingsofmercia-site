---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import Content from '~/components/widgets/Content.astro';
import Image from '~/components/common/Image.astro';
import { Icon } from 'astro-icon/components';

const metadata = {
  title: 'Bio',
};
---

<Layout metadata={metadata}>
  <!-- HeroText Widget ******************* -->
  <HeroText title="Biography" tagline="Kings Of Mercia" />

  <!-- Band Profiles Widget ******************* -->
  <section class="max-w-6xl mx-auto px-4 sm:px-6 mb-16">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-8 md:gap-12 justify-center">
      <!-- Steve Overland -->
      <div class="flex flex-col items-center text-center group">
        <div
          class="relative w-36 h-36 sm:w-48 sm:h-48 rounded-full overflow-hidden shadow-lg border-4 border-slate-200 dark:border-slate-800 transition-transform duration-300 group-hover:scale-105"
        >
          <Image
            src="~/assets/images/steve_overland_portrait.png"
            alt="Steve Overland"
            class="object-cover w-full h-full"
            width={300}
            height={300}
          />
        </div>
        <h3 class="mt-4 text-xl font-bold tracking-tight dark:text-white font-heading">Steve Overland</h3>
        <p class="text-slate-600 dark:text-slate-400 text-sm mt-1">Vocals</p>
        <div class="w-12 h-0.5 bg-secondary dark:bg-accent my-3"></div>
        <div class="flex space-x-3 mt-1">
          <a
            href="https://www.facebook.com/p/Steve-Overland-100063560647164/"
            target="_blank"
            rel="noopener noreferrer"
            class="text-slate-500 hover:text-primary dark:text-slate-400 dark:hover:text-accent transition-colors"
            aria-label="Steve Overland Facebook"
          >
            <Icon name="tabler:brand-facebook" class="w-5 h-5" />
          </a>
        </div>
      </div>

      <!-- Jim Matheos -->
      <div class="flex flex-col items-center text-center group">
        <div
          class="relative w-36 h-36 sm:w-48 sm:h-48 rounded-full overflow-hidden shadow-lg border-4 border-slate-200 dark:border-slate-800 transition-transform duration-300 group-hover:scale-105"
        >
          <Image
            src="~/assets/images/jim_2024_01_300x300rev.png"
            alt="Jim Matheos"
            class="object-cover w-full h-full"
            width={300}
            height={300}
          />
        </div>
        <h3 class="mt-4 text-xl font-bold tracking-tight dark:text-white font-heading">Jim Matheos</h3>
        <p class="text-slate-600 dark:text-slate-400 text-sm mt-1">Guitar</p>
        <div class="w-12 h-0.5 bg-secondary dark:bg-accent my-3"></div>
        <div class="flex space-x-3 mt-1">
          <a
            href="https://www.facebook.com/JimMatheosOfficial"
            target="_blank"
            rel="noopener noreferrer"
            class="text-slate-500 hover:text-primary dark:text-slate-400 dark:hover:text-accent transition-colors"
            aria-label="Jim Matheos Facebook"
          >
            <Icon name="tabler:brand-facebook" class="w-5 h-5" />
          </a>
          <a
            href="https://jimmatheos.com/"
            target="_blank"
            rel="noopener noreferrer"
            class="text-slate-500 hover:text-primary dark:text-slate-400 dark:hover:text-accent transition-colors"
            aria-label="Jim Matheos Website"
          >
            <Icon name="tabler:world" class="w-5 h-5" />
          </a>
        </div>
      </div>

      <!-- Joey Vera -->
      <div class="flex flex-col items-center text-center group">
        <div
          class="relative w-36 h-36 sm:w-48 sm:h-48 rounded-full overflow-hidden shadow-lg border-4 border-slate-200 dark:border-slate-800 transition-transform duration-300 group-hover:scale-105"
        >
          <Image
            src="~/assets/images/joey_vera_portrait.png"
            alt="Joey Vera"
            class="object-cover w-full h-full"
            width={300}
            height={300}
          />
        </div>
        <h3 class="mt-4 text-xl font-bold tracking-tight dark:text-white font-heading">Joey Vera</h3>
        <p class="text-slate-600 dark:text-slate-400 text-sm mt-1">Bass</p>
        <div class="w-12 h-0.5 bg-secondary dark:bg-accent my-3"></div>
        <div class="flex space-x-3 mt-1">
          <a
            href="https://www.facebook.com/JoeyVeraOfficial"
            target="_blank"
            rel="noopener noreferrer"
            class="text-slate-500 hover:text-primary dark:text-slate-400 dark:hover:text-accent transition-colors"
            aria-label="Joey Vera Facebook"
          >
            <Icon name="tabler:brand-facebook" class="w-5 h-5" />
          </a>
          <a
            href="https://joeyvera.com/"
            target="_blank"
            rel="noopener noreferrer"
            class="text-slate-500 hover:text-primary dark:text-slate-400 dark:hover:text-accent transition-colors"
            aria-label="Joey Vera Website"
          >
            <Icon name="tabler:world" class="w-5 h-5" />
          </a>
        </div>
      </div>

      <!-- Simon Phillips -->
      <div class="flex flex-col items-center text-center group">
        <div
          class="relative w-36 h-36 sm:w-48 sm:h-48 rounded-full overflow-hidden shadow-lg border-4 border-slate-200 dark:border-slate-800 transition-transform duration-300 group-hover:scale-105"
        >
          <Image
            src="~/assets/images/simon_phillips_portrait.png"
            alt="Simon Phillips"
            class="object-cover w-full h-full"
            width={300}
            height={300}
          />
        </div>
        <h3 class="mt-4 text-xl font-bold tracking-tight dark:text-white font-heading">Simon Phillips</h3>
        <p class="text-slate-600 dark:text-slate-400 text-sm mt-1">Drums</p>
        <div class="w-12 h-0.5 bg-secondary dark:bg-accent my-3"></div>
        <div class="flex space-x-3 mt-1">
          <a
            href="https://www.facebook.com/SimonPhillipsDrums"
            target="_blank"
            rel="noopener noreferrer"
            class="text-slate-500 hover:text-primary dark:text-slate-400 dark:hover:text-accent transition-colors"
            aria-label="Simon Phillips Facebook"
          >
            <Icon name="tabler:brand-facebook" class="w-5 h-5" />
          </a>
          <a
            href="https://www.simon-phillips.com/"
            target="_blank"
            rel="noopener noreferrer"
            class="text-slate-500 hover:text-primary dark:text-slate-400 dark:hover:text-accent transition-colors"
            aria-label="Simon Phillips Website"
          >
            <Icon name="tabler:world" class="w-5 h-5" />
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Content Widget: Battle Scars (2024) ****************** -->
  <Content
    isAfterContent
    isBeforeContent
    isReversed={true}
    image={{
      src: '~/assets/images/battle_scars_cover.jpg',
      alt: 'Kings Of Mercia - Battle Scars',
      caption: 'Battle Scars (2024)',
      captionJustification: 'center',
    }}
  >
    <Fragment slot="content">
      <h2 class="text-3xl font-bold tracking-tight dark:text-white sm:text-4xl mb-4 font-heading">
        Battle Scars (2024)
      </h2>
      <div class="mb-6 font-semibold dark:text-slate-200">
        <p>Steve Overland: Vocals</p>
        <p>Jim Matheos: Guitars</p>
        <p>Joey Vera: Bass</p>
        <p>Simon Phillips: Drums</p>
      </div>
      <div class="space-y-4 text-justify">
        <p>
          Following their acclaimed 2022 self-titled debut, <strong>Kings Of Mercia</strong> returned in 2024 with their powerful
          sophomore album, <em><strong>Battle Scars</strong></em>.
        </p>
        <p>
          Formed by legendary Fates Warning guitarist <strong>Jim Matheos</strong> and FM's frontman <strong
            >Steve Overland</strong
          >, the band is a dedicated, living musical entity. Once again, they are joined by the powerhouse rhythm
          section of bassist <strong>Joey Vera</strong> (Armored Saint, Fates Warning) and legendary drummer <strong
            >Simon Phillips</strong
          > (The Who, Toto).
        </p>
        <p>
          Overland explains the growth of the group: <em
            >"On the first album, Jim and I were testing the waters. With Battle Scars, we knew exactly what we wanted
            to achieve. The songs are heavier, yet they retain that strong melodic edge and big hooks that define our
            sound."</em
          >
        </p>
        <p>
          Matheos adds: <em
            >"Working with Steve is an absolute pleasure. He is one of the great voices in rock music, and Simon and
            Joey take the songs to a level that is simply world-class."</em
          >
        </p>
        <p>
          From the hard-rocking opener <em>"Guns and Ammunition"</em> to the soulful heights of <em
            >"Between Two Worlds"</em
          > and the brooding title track <em>"Battle Scars"</em>, the record represents a peak of heavy, melodic
          progressive rock.
        </p>
      </div>
    </Fragment>
  </Content>

  <!-- Content Widget: Debut Album (2022) ****************** -->
  <Content
    isAfterContent
    isBeforeContent
    isReversed={false}
    image={{
      src: '~/assets/images/kings_of_mercia_debut_cover.png',
      alt: 'Kings Of Mercia Debut Album (2022)',
      caption: 'Kings Of Mercia (2022)',
      captionJustification: 'center',
    }}
  >
    <Fragment slot="content">
      <h2 class="text-3xl font-bold tracking-tight dark:text-white sm:text-4xl mb-4 font-heading">
        Kings Of Mercia (2022)
      </h2>
      <div class="space-y-6 text-justify">
        <div>
          <h3 class="text-lg font-bold tracking-tight dark:text-white mb-2 font-heading uppercase text-secondary">
            History & Formation
          </h3>
          <p class="text-muted dark:text-slate-400">
            <strong>Kings Of Mercia</strong> was formed in early 2021 when guitarist <strong>Jim Matheos</strong> began writing
            material that was separate from his typical progressive metal work, leaning more towards a hard-rocking, melodic
            style. Looking for a singer who could do the songs justice, he was connected to vocalist <strong
              >Steve Overland</strong
            > of the British AOR band FM.
          </p>
          <p class="text-muted dark:text-slate-400 mt-2">
            The chemistry between Overland's soulful, bluesy vocals and Matheos' signature heavy riffs was
            instantaneous. They subsequently recruited bassist <strong>Joey Vera</strong> (Matheos' Fates Warning bandmate)
            and world-renowned drummer <strong>Simon Phillips</strong> (ex-Toto, Protocol) to complete the lineup.
          </p>
        </div>

        <div>
          <h3 class="text-lg font-bold tracking-tight dark:text-white mb-2 font-heading uppercase text-secondary">
            Debut Release
          </h3>
          <p class="text-muted dark:text-slate-400">
            The self-titled debut was released on September 23, 2022, via Metal Blade Records, receiving praise as an
            intoxicating blend of heavy guitar riffs, driving rhythms, and rich vocal harmonies. The lead single, <em
              >"Wrecking Ball"</em
            >, established the band's identity right out of the gate.
          </p>
          <p class="text-muted dark:text-slate-400 mt-2">
            <em>"The chemistry between all of us was there immediately, despite recording remotely,"</em> says Matheos. <em
              >"Simon's drum tracks brought an incredible energy, and Joey's bass lines are always perfect. It really
              came together as a true band effort rather than just a studio project."</em
            >
          </p>
        </div>
      </div>
    </Fragment>
  </Content>
</Layout>
